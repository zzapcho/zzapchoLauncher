{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zzapcho Launcher",
  "version": "0.1.0",
  "identifier": "kr.zzapcho.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "zzapcho Launcher", "width": 420, "height": 560, "minWidth": 420, "minHeight": 560, "resizable": true, "maximizable": true, "decorations": false, "shadow": true, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

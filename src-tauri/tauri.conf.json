{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zzapcho Launcher",
  "version": "0.6.2",
  "identifier": "kr.zzapcho.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "zzapcho Launcher", "width": 420, "height": 560, "minWidth": 420, "minHeight": 560, "resizable": true, "maximizable": true, "decorations": false, "shadow": true, "center": true, "backgroundColor": "#0b1511" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2M0EzODJBRUE3MzBGMjcKUldRbkQzUHFLamc2eGtZd3RkYjZMOWtCU0lXR1hwNFRqd05OZlpSbDBrSWZVa29ha2dCZFhTS3EK",
      "endpoints": [
        "https://github.com/zzapcho/zzapchoLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
